{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandRegistryEntry",
  "type": "object",
  "required": [
    "brand_id",
    "display_name",
    "category",
    "official_domains",
    "canonical_url",
    "tokens",
    "token_match",
    "verified",
    "version"
  ],
  "properties": {
    "brand_id": { "type": "string" },
    "display_name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "category": { "type": "string" },
    "official_domains": { "type": "array", "items": { "type": "string" } },
    "associated_domains": { "type": "array", "items": { "type": "string" } },
    "canonical_url": { "type": "string", "format": "uri" },
    "login_url": { "type": ["string", "null"] },
    "deep_links": { "type": "object", "additionalProperties": { "type": "string" } },
    "tokens": { "type": "array", "items": { "type": "string" } },
    "token_match": { "type": "string", "enum": ["substring", "exact_only"] },
    "logo_hashes": { "type": "array", "items": { "type": "string" } },
    "languages": { "type": "array", "items": { "type": "string" } },
    "verified": { "type": "boolean" },
    "needs_verification": { "type": "boolean" },
    "last_verified": { "type": ["string", "null"] },
    "verified_by": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "version": { "type": "integer" },
    "dev_only": { "type": "boolean" },
    "shared_hosting_risk": { "type": "boolean" },
    "signature": { "type": ["string", "null"] }
  }
}
