{
  "manifest_version": 3,
  "name": "SiteGuard",
  "version": "0.1.0",
  "description": "Warns about fake bank and government sites and takes you to the real one.",
  "permissions": [
    "webNavigation",
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SiteGuard"
  }
}
